/****************************************************
 * 🚑 웹 구급일지 - Google Apps Script
 *
 * 기능
 * 1. 웹 HTML → Google Sheets 저장
 * 2. Google Sheets 헤더 자동 생성
 * 3. 새로운 항목이 추가되면 새로운 열 자동 생성
 * 4. 무제한 활력징후 저장
 * 5. KTAS 저장
 * 6. GCS 저장
 * 7. 처치/환자정보/출동정보 저장
 * 8. 저장일시 자동 기록
 ****************************************************/


/* ==================================================
   기본 설정
================================================== */

const SHEET_NAME = "구급일지";


/* ==================================================
   GET
   웹브라우저에서 Apps Script 주소를 직접 열었을 때
================================================== */

function doGet(e) {

  return ContentService
    .createTextOutput(
      JSON.stringify({
        success: true,
        message: "🚑 웹 구급일지 Google Apps Script 정상 작동",
        time: new Date()
      })
    )
    .setMimeType(ContentService.MimeType.JSON);

}


/* ==================================================
   POST
   HTML에서 구급일지 데이터를 받을 때
================================================== */

function doPost(e) {

  try {

    if (!e || !e.postData || !e.postData.contents) {

      return jsonResponse({
        success: false,
        message: "전송된 데이터가 없습니다."
      });

    }


    /* ----------------------------------------------
       JSON 데이터 읽기
    ---------------------------------------------- */

    const data =
      JSON.parse(e.postData.contents);


    /* ----------------------------------------------
       Spreadsheet
    ---------------------------------------------- */

    const spreadsheet =
      SpreadsheetApp.getActiveSpreadsheet();


    /* ----------------------------------------------
       시트 찾기
       없으면 자동 생성
    ---------------------------------------------- */

    let sheet =
      spreadsheet.getSheetByName(SHEET_NAME);


    if (!sheet) {

      sheet =
        spreadsheet.insertSheet(SHEET_NAME);

    }


    /* ----------------------------------------------
       저장할 데이터가 없는 경우
    ---------------------------------------------- */

    if (
      !data ||
      Object.keys(data).length === 0
    ) {

      return jsonResponse({
        success: false,
        message: "저장할 데이터가 없습니다."
      });

    }


    /* ----------------------------------------------
       필요한 헤더 생성
    ---------------------------------------------- */

    const headers =
      buildHeaders(data);


    /* ----------------------------------------------
       Google Sheets 헤더 확인 및 추가
    ---------------------------------------------- */

    ensureHeaders(
      sheet,
      headers
    );


    /* ----------------------------------------------
       현재 Google Sheets의 실제 헤더 읽기
    ---------------------------------------------- */

    const lastColumn =
      sheet.getLastColumn();


    const sheetHeaders =
      sheet
        .getRange(
          1,
          1,
          1,
          lastColumn
        )
        .getValues()[0];


    /* ----------------------------------------------
       실제 저장 행 생성
    ---------------------------------------------- */

    const row =
      sheetHeaders.map(header => {

        /* 저장일시 */
        if (header === "저장일시") {

          return new Date();

        }


        /* 데이터 찾기 */
        const value =
          data[header];


        /* 배열 */
        if (Array.isArray(value)) {

          return value.join(", ");

        }


        /* 객체 */
        if (
          typeof value === "object" &&
          value !== null
        ) {

          return JSON.stringify(value);

        }


        /* 빈 값 */
        if (
          value === undefined ||
          value === null
        ) {

          return "";

        }


        return value;

      });


    /* ----------------------------------------------
       Google Sheets 마지막 행에 저장
    ---------------------------------------------- */

    sheet.appendRow(row);


    /* ----------------------------------------------
       스타일 적용
    ---------------------------------------------- */

    formatSheet(sheet);


    /* ----------------------------------------------
       성공 응답
    ---------------------------------------------- */

    return jsonResponse({

      success: true,

      message:
        "구급일지가 Google Sheets에 저장되었습니다.",

      row:
        sheet.getLastRow(),

      sheet:
        SHEET_NAME

    });


  } catch (error) {


    console.error(error);


    return jsonResponse({

      success: false,

      message:
        "저장 중 오류가 발생했습니다.",

      error:
        error.toString()

    });

  }

}


/* ==================================================
   헤더 생성
================================================== */

function buildHeaders(data) {

  const headers = [];


  /* ----------------------------------------------
     항상 첫 번째 컬럼
  ---------------------------------------------- */

  headers.push("저장일시");


  /* ----------------------------------------------
     웹에서 전달된 모든 항목
  ---------------------------------------------- */

  Object.keys(data).forEach(key => {

    if (
      key &&
      !headers.includes(key)
    ) {

      headers.push(key);

    }

  });


  return headers;

}


/* ==================================================
   Google Sheets 헤더 자동 생성
================================================== */

function ensureHeaders(
  sheet,
  headers
) {


  /* ----------------------------------------------
     새 시트인 경우
  ---------------------------------------------- */

  if (
    sheet.getLastRow() === 0 ||
    sheet.getLastColumn() === 0
  ) {

    sheet
      .getRange(
        1,
        1,
        1,
        headers.length
      )
      .setValues([headers]);


    formatHeader(sheet);


    return;

  }


  /* ----------------------------------------------
     기존 헤더 읽기
  ---------------------------------------------- */

  const lastColumn =
    sheet.getLastColumn();


  const currentHeaders =
    sheet
      .getRange(
        1,
        1,
        1,
        lastColumn
      )
      .getValues()[0];


  /* ----------------------------------------------
     새로운 헤더만 찾기
  ---------------------------------------------- */

  const newHeaders =
    headers.filter(header => {

      return !currentHeaders.includes(
        header
      );

    });


  /* ----------------------------------------------
     새로운 헤더가 없는 경우
  ---------------------------------------------- */

  if (
    newHeaders.length === 0
  ) {

    return;

  }


  /* ----------------------------------------------
     새로운 열 추가
  ---------------------------------------------- */

  const startColumn =
    currentHeaders.length + 1;


  sheet
    .getRange(
      1,
      startColumn,
      1,
      newHeaders.length
    )
    .setValues([
      newHeaders
    ]);


  formatHeader(sheet);

}


/* ==================================================
   헤더 스타일
================================================== */

function formatHeader(sheet) {

  const lastColumn =
    sheet.getLastColumn();


  if (lastColumn <= 0) {

    return;

  }


  const headerRange =
    sheet.getRange(
      1,
      1,
      1,
      lastColumn
    );


  headerRange
    .setBackground("#d71920")
    .setFontColor("#ffffff")
    .setFontWeight("bold")
    .setHorizontalAlignment("center")
    .setVerticalAlignment("middle");


  /* 첫 번째 행 고정 */

  sheet.setFrozenRows(1);


  /* 열 너비 자동 조정 */

  sheet.autoResizeColumns(
    1,
    lastColumn
  );

}


/* ==================================================
   전체 시트 스타일
================================================== */

function formatSheet(sheet) {

  const lastRow =
    sheet.getLastRow();

  const lastColumn =
    sheet.getLastColumn();


  if (
    lastRow < 1 ||
    lastColumn < 1
  ) {

    return;

  }


  /* 헤더 */

  formatHeader(sheet);


  /* 본문 */

  if (lastRow >= 2) {

    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        lastColumn
      )
      .setVerticalAlignment(
        "middle"
      );

  }

}


/* ==================================================
   JSON 응답
================================================== */

function jsonResponse(data) {

  return ContentService
    .createTextOutput(
      JSON.stringify(data)
    )
    .setMimeType(
      ContentService.MimeType.JSON
    );

}


