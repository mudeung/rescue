<!DOCTYPE html>
<html lang="ko">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>웹 구급일지</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family:
        Arial,
        "Malgun Gothic",
        sans-serif;

    background: #eef2f5;
    color: #222;
}

.container {
    max-width: 1100px;
    margin: 30px auto;
    padding: 20px;
}

.header {
    background: #d71920;
    color: white;
    padding: 20px;
    border-radius: 12px 12px 0 0;
}

.header h1 {
    margin: 0;
    font-size: 26px;
}

.header p {
    margin: 6px 0 0;
    opacity: .9;
}

.card {
    background: white;
    padding: 22px;
    margin-bottom: 15px;
    border-radius: 10px;

    box-shadow:
        0 2px 8px
        rgba(0,0,0,.08);
}

.card h2 {
    margin-top: 0;

    border-left:
        5px solid #d71920;

    padding-left: 10px;

    font-size: 19px;
}

.grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 15px;
}

.field {
    display: flex;
    flex-direction: column;
}

.field.full {
    grid-column: 1 / -1;
}

label {
    font-weight: bold;
    margin-bottom: 6px;
    font-size: 14px;
}

input,
select,
textarea {

    width: 100%;

    padding: 10px;

    border:
        1px solid #ccc;

    border-radius: 6px;

    font-size: 14px;
}

textarea {
    min-height: 100px;
    resize: vertical;
}


/* KTAS */

.ktas-box {
    padding: 15px;

    border-radius: 8px;

    background: #f7f7f7;

    border:
        1px solid #ddd;
}

.ktas-description {
    margin-top: 8px;

    padding: 10px;

    border-radius: 6px;

    background: #fff;

    font-size: 13px;

    color: #555;
}


/* 활력징후 */

.vital-wrapper {
    overflow-x: auto;
}

.vital-table {
    width: 100%;

    border-collapse:
        collapse;

    min-width: 900px;
}

.vital-table th,
.vital-table td {

    border:
        1px solid #ddd;

    padding: 8px;

    text-align: center;
}

.vital-table th {

    background:
        #f4f4f4;

    white-space:
        nowrap;
}

.vital-table input {
    min-width: 80px;
}

.vital-number {
    font-weight: bold;
}


/* 버튼 */

.buttons {

    display: flex;

    flex-wrap: wrap;

    gap: 10px;

    margin-top: 20px;
}

button {

    border: none;

    padding:
        13px 22px;

    border-radius: 7px;

    font-size: 15px;

    font-weight: bold;

    cursor: pointer;
}

button:hover {
    opacity: .85;
}

.save {
    background: #1976d2;
    color: white;
}

.sheet {
    background: #168a45;
    color: white;
}

.print {
    background: #444;
    color: white;
}

.reset {
    background: #eee;
    color: #333;
}

.add-vital {

    background: #d71920;

    color: white;

    margin-bottom: 12px;
}

.delete-vital {

    background: #ef4444;

    color: white;

    padding:
        7px 10px;

    font-size: 12px;
}


/* 처치 */

.check-group {

    display: flex;

    flex-wrap: wrap;

    gap: 15px;
}

.check-group label {

    font-weight: normal;

    display: flex;

    align-items: center;

    gap: 5px;
}


/* 상태 */

.status {

    margin-top: 15px;

    padding: 12px;

    border-radius: 7px;

    display: none;
}

.status.success {

    display: block;

    background: #dcfce7;

    color: #166534;
}

.status.error {

    display: block;

    background: #fee2e2;

    color: #991b1b;
}


/* footer */

.footer {

    text-align: center;

    color: #777;

    font-size: 12px;

    margin-top: 20px;
}


/* 모바일 */

@media(max-width:700px) {

    .grid {
        grid-template-columns: 1fr;
    }

    .container {
        margin: 10px;
        padding: 5px;
    }

}


/* 인쇄 */

@media print {

    body {
        background: white;
    }

    .container {
        max-width: none;
        margin: 0;
        padding: 0;
    }

    .buttons,
    .add-vital,
    .delete-vital,
    .status {
        display: none !important;
    }

    .card {

        box-shadow: none;

        border:
            1px solid #ddd;

        page-break-inside:
            avoid;
    }

    .header {

        background:
            #d71920 !important;

        -webkit-print-color-adjust:
            exact;

        print-color-adjust:
            exact;
    }

}

</style>

</head>


<body>

<div class="container">


<!-- HEADER -->

<div class="header">

    <h1>🚑 웹 구급일지</h1>

    <p>
        구급활동 기록 및 환자 처치 기록
    </p>

</div>


<!-- 출동정보 -->

<div class="card">

<h2>1. 출동 정보</h2>

<div class="grid">

<div class="field">

<label>출동번호</label>

<input
    type="text"
    id="callNumber"
>

</div>


<div class="field">

<label>출동일자</label>

<input
    type="date"
    id="date"
>

</div>


<div class="field">

<label>출동시간</label>

<input
    type="time"
    id="dispatchTime"
>

</div>


<div class="field">

<label>현장 도착시간</label>

<input
    type="time"
    id="arrivalTime"
>

</div>


<div class="field">

<label>현장 출발시간</label>

<input
    type="time"
    id="departureTime"
>

</div>


<div class="field">

<label>귀소시간</label>

<input
    type="time"
    id="returnTime"
>

</div>


<div class="field full">

<label>사고/출동 장소</label>

<input
    type="text"
    id="location"
    placeholder="주소 또는 사고 장소"
>

</div>

</div>

</div>


<!-- 사고유형 / KTAS -->

<div class="card">

<h2>2. 사고유형 및 KTAS</h2>

<div class="grid">


<div class="field">

<label>사고유형</label>

<select id="accidentType">

<option value="">
선택
</option>

<option>
질환
</option>

<option>
외상
</option>

<option>
교통사고
</option>

<option>
추락
</option>

<option>
실족
</option>

<option>
익수
</option>

<option>
화상
</option>

<option>
중독
</option>

<option>
동물/곤충
</option>

<option>
환경응급
</option>

<option>
심정지
</option>

<option>
기타
</option>

</select>

</div>


<div class="field">

<label>KTAS 분류</label>

<select
    id="ktas"
    onchange="updateKTASDescription()"
>

<option value="">
선택
</option>

<option value="KTAS 1">
KTAS 1 - 소생
</option>

<option value="KTAS 2">
KTAS 2 - 긴급
</option>

<option value="KTAS 3">
KTAS 3 - 응급
</option>

<option value="KTAS 4">
KTAS 4 - 준응급
</option>

<option value="KTAS 5">
KTAS 5 - 비응급
</option>

</select>

</div>


<div
    class="field full"
>

<div
    id="ktasDescription"
    class="ktas-description"
>
KTAS 단계를 선택하면 설명이 표시됩니다.
</div>

</div>

</div>

</div>


<!-- 환자정보 -->

<div class="card">

<h2>3. 환자 정보</h2>

<div class="grid">


<div class="field">

<label>성명</label>

<input
    type="text"
    id="patientName"
>

</div>


<div class="field">

<label>성별</label>

<select id="gender">

<option value="">
선택
</option>

<option>
남성
</option>

<option>
여성
</option>

<option>
미상
</option>

</select>

</div>


<div class="field">

<label>나이</label>

<input
    type="number"
    id="age"
    min="0"
    max="150"
>

</div>


<div class="field">

<label>생년월일</label>

<input
    type="date"
    id="birthDate"
>

</div>


<div class="field">

<label>보호자</label>

<input
    type="text"
    id="guardian"
>

</div>


<div class="field">

<label>연락처</label>

<input
    type="tel"
    id="phone"
    placeholder="010-0000-0000"
>

</div>

</div>

</div>


<!-- 환자상태 -->

<div class="card">

<h2>4. 환자 상태</h2>

<div class="grid">


<div class="field">

<label>의식상태</label>

<select id="consciousness">

<option value="">
선택
</option>

<option>
Alert
</option>

<option>
Verbal
</option>

<option>
Pain
</option>

<option>
Unresponsive
</option>

</select>

</div>


<div class="field">

<label>주호소</label>

<input
    type="text"
    id="chiefComplaint"
>

</div>


<div class="field">

<label>발병/사고 시각</label>

<input
    type="time"
    id="onsetTime"
>

</div>


<div class="field full">

<label>
환자 상태 및 증상
</label>

<textarea
    id="symptoms"
    placeholder="환자의 상태, 증상, 사고 상황 등을 기록하세요."
></textarea>

</div>

</div>

</div>


<!-- 활력징후 -->

<div class="card">

<h2>5. 활력징후</h2>

<p style="color:#666;font-size:13px;">

측정할 때마다 아래 버튼으로 새로운 활력징후를 추가할 수 있습니다.

</p>


<button
    type="button"
    class="add-vital"
    onclick="addVitalRow()"
>
＋ 활력징후 추가
</button>


<div class="vital-wrapper">

<table class="vital-table">

<thead>

<tr>

<th>순번</th>

<th>측정시각</th>

<th>혈압</th>

<th>맥박</th>

<th>호흡</th>

<th>체온</th>

<th>SpO₂</th>

<th>혈당</th>

<th>기타</th>

<th>삭제</th>

</tr>

</thead>


<tbody id="vitalBody">

</tbody>

</table>

</div>

</div>


<!-- 처치 -->

<div class="card">

<h2>6. 실시한 처치</h2>


<div class="check-group">

<label>
<input
    type="checkbox"
    name="treatment"
    value="기도확보"
>
기도확보
</label>


<label>
<input
    type="checkbox"
    name="treatment"
    value="산소투여"
>
산소투여
</label>


<label>
<input
    type="checkbox"
    name="treatment"
    value="심폐소생술"
>
심폐소생술
</label>


<label>
<input
    type="checkbox"
    name="treatment"
    value="AED"
>
AED
</label>


<label>
<input
    type="checkbox"
    name="treatment"
    value="지혈"
>
지혈
</label>


<label>
<input
    type="checkbox"
    name="treatment"
    value="부목/고정"
>
부목/고정
</label>


<label>
<input
    type="checkbox"
    name="treatment"
    value="환자이송"
>
환자이송
</label>

</div>


<br>


<textarea
    id="treatmentMemo"
    placeholder="기타 처치 내용 및 처치 경과"
></textarea>

</div>


<!-- 이송 -->

<div class="card">

<h2>7. 이송 정보</h2>

<div class="grid">


<div class="field">

<label>이송 여부</label>

<select id="transport">

<option value="">
선택
</option>

<option>
이송
</option>

<option>
미이송
</option>

<option>
현장처치
</option>

</select>

</div>


<div class="field">

<label>이송 병원</label>

<input
    type="text"
    id="hospital"
>

</div>


<div class="field">

<label>이송 시작시간</label>

<input
    type="time"
    id="transportTime"
>

</div>


<div class="field full">

<label>
이송 사유 / 환자 인계사항
</label>

<textarea
    id="handover"
></textarea>

</div>

</div>

</div>


<!-- 대원 -->

<div class="card">

<h2>8. 구급대원 정보</h2>

<div class="grid">


<div class="field">

<label>구급대원 1</label>

<input
    type="text"
    id="crew1"
>

</div>


<div class="field">

<label>구급대원 2</label>

<input
    type="text"
    id="crew2"
>

</div>


<div class="field">

<label>운전요원</label>

<input
    type="text"
    id="driver"
>

</div>

</div>

</div>


<!-- 기타 -->

<div class="card">

<h2>9. 기타</h2>

<textarea
    id="memo"
    placeholder="기타 특이사항"
></textarea>


<div class="buttons">

<button
    class="save"
    onclick="saveLocal()"
>
💾 임시저장
</button>


<button
    class="sheet"
    onclick="saveToGoogleSheets()"
>
☁️ Google Sheets 저장
</button>


<button
    class="print"
    onclick="window.print()"
>
🖨️ 인쇄
</button>


<button
    class="reset"
    onclick="resetForm()"
>
🔄 초기화
</button>

</div>


<div id="status" class="status"></div>

</div>


<div class="footer">

웹 구급일지

</div>


</div>


<script>

/*************************************************
 * Google Apps Script Web App 주소
 *
 * 아래 주소를 본인의 Apps Script /exec 주소로 변경
 *************************************************/

const GOOGLE_SCRIPT_URL =
"https://script.google.com/macros/s/여기에배포주소/exec";


/*************************************************
 * 페이지 초기화
 *************************************************/

window.addEventListener(
    "load",
    function() {

        setToday();

        loadLocal();

        if (
            document.querySelectorAll(
                "#vitalBody tr"
            ).length === 0
        ) {

            addVitalRow();

        }

    }
);


/*************************************************
 * 오늘 날짜
 *************************************************/

function setToday() {

    const date =
        document.getElementById("date");

    if (!date.value) {

        date.value =
            new Date()
                .toISOString()
                .split("T")[0];

    }

}


/*************************************************
 * KTAS 설명
 *************************************************/

function updateKTASDescription() {

    const value =
        document.getElementById("ktas").value;

    const box =
        document.getElementById(
            "ktasDescription"
        );


    const descriptions = {

        "KTAS 1":
            "소생: 즉각적인 처치가 필요한 상태",

        "KTAS 2":
            "긴급: 생명 또는 신체기능에 위협이 있어 신속한 평가와 처치가 필요한 상태",

        "KTAS 3":
            "응급: 응급한 상태로 평가와 처치가 필요한 상태",

        "KTAS 4":
            "준응급: 비교적 안정적이나 평가와 처치가 필요한 상태",

        "KTAS 5":
            "비응급: 긴급성이 낮은 상태"

    };


    box.textContent =
        descriptions[value] ||
        "KTAS 단계를 선택하면 설명이 표시됩니다.";

}


/*************************************************
 * 활력징후 행 추가
 *************************************************/

function addVitalRow(data = {}) {

    const tbody =
        document.getElementById(
            "vitalBody"
        );


    const number =
        tbody.children.length + 1;


    const tr =
        document.createElement("tr");


    tr.innerHTML = `

        <td class="vital-number">
            ${number}
        </td>

        <td>
            <input
                type="time"
                class="vital-time"
                value="${escapeHtml(data.time || "")}"
            >
        </td>

        <td>
            <input
                type="text"
                class="vital-bp"
                placeholder="120/80"
                value="${escapeHtml(data.bp || "")}"
            >
        </td>

        <td>
            <input
                type="number"
                class="vital-pulse"
                value="${escapeHtml(data.pulse || "")}"
            >
        </td>

        <td>
            <input
                type="number"
                class="vital-resp"
                value="${escapeHtml(data.resp || "")}"
            >
        </td>

        <td>
            <input
                type="number"
                step="0.1"
                class="vital-temp"
                value="${escapeHtml(data.temp || "")}"
            >
        </td>

        <td>
            <input
                type="number"
                class="vital-spo2"
                value="${escapeHtml(data.spo2 || "")}"
            >
        </td>

        <td>
            <input
                type="number"
                class="vital-glucose"
                value="${escapeHtml(data.glucose || "")}"
            >
        </td>

        <td>
            <input
                type="text"
                class="vital-memo"
                value="${escapeHtml(data.memo || "")}"
            >
        </td>

        <td>

            <button
                type="button"
                class="delete-vital"
                onclick="deleteVitalRow(this)"
            >
                삭제
            </button>

        </td>

    `;


    tbody.appendChild(tr);

    renumberVitals();

}


/*************************************************
 * 활력징후 삭제
 *************************************************/

function deleteVitalRow(button) {

    const tr =
        button.closest("tr");

    tr.remove();

    renumberVitals();

}


/*************************************************
 * 활력징후 번호 재정렬
 *************************************************/

function renumberVitals() {

    const rows =
        document.querySelectorAll(
            "#vitalBody tr"
        );


    rows.forEach(
        function(row, index) {

            row.querySelector(
                ".vital-number"
            ).textContent =
                index + 1;

        }
    );

}


/*************************************************
 * 활력징후 데이터 수집
 *************************************************/

function collectVitals() {

    const rows =
        document.querySelectorAll(
            "#vitalBody tr"
        );


    const vitals = [];


    rows.forEach(
        function(row) {

            vitals.push({

                time:
                    row.querySelector(
                        ".vital-time"
                    ).value,

                bp:
                    row.querySelector(
                        ".vital-bp"
                    ).value,

                pulse:
                    row.querySelector(
                        ".vital-pulse"
                    ).value,

                resp:
                    row.querySelector(
                        ".vital-resp"
                    ).value,

                temp:
                    row.querySelector(
                        ".vital-temp"
                    ).value,

                spo2:
                    row.querySelector(
                        ".vital-spo2"
                    ).value,

                glucose:
                    row.querySelector(
                        ".vital-glucose"
                    ).value,

                memo:
                    row.querySelector(
                        ".vital-memo"
                    ).value

            });

        }
    );


    return vitals;

}


/*************************************************
 * 처치 데이터
 *************************************************/

function collectTreatments() {

    return Array.from(
        document.querySelectorAll(
            'input[name="treatment"]:checked'
        )
    ).map(
        checkbox =>
            checkbox.value
    );

}


/*************************************************
 * 전체 데이터 수집
 *************************************************/

function collectData() {

    return {

        callNumber:
            document.getElementById(
                "callNumber"
            ).value,

        date:
            document.getElementById(
                "date"
            ).value,

        dispatchTime:
            document.getElementById(
                "dispatchTime"
            ).value,

        arrivalTime:
            document.getElementById(
                "arrivalTime"
            ).value,

        departureTime:
            document.getElementById(
                "departureTime"
            ).value,

        returnTime:
            document.getElementById(
                "returnTime"
            ).value,

        location:
            document.getElementById(
                "location"
            ).value,

        accidentType:
            document.getElementById(
                "accidentType"
            ).value,

        ktas:
            document.getElementById(
                "ktas"
            ).value,

        patientName:
            document.getElementById(
                "patientName"
            ).value,

        gender:
            document.getElementById(
                "gender"
            ).value,

        age:
            document.getElementById(
                "age"
            ).value,

        birthDate:
            document.getElementById(
                "birthDate"
            ).value,

        guardian:
            document.getElementById(
                "guardian"
