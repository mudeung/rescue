/* =========================================================
   활력징후 행 삭제
========================================================= */

function deleteVitalRow(
    button
) {

    const row =
        button.closest(
            ".vital-row"
        );


    if (!row) {

        return;

    }


    const index =
        parseInt(
            row.dataset.index
        );


    if (index <= 2) {

        return;

    }


    row.remove();


    renumberVitalRows();

}


/* =========================================================
   활력징후 번호 재정렬
========================================================= */

function renumberVitalRows() {

    const rows =
        document.querySelectorAll(
            "#vitalBody .vital-row"
        );


    rows.forEach(
        function(row, index) {

            const number =
                index + 1;


            row.dataset.index =
                number;


            const label =
                row.querySelector(
                    "td:first-child strong"
                );


            if (label) {

                label.textContent =
                    `${number}차`;

            }

        }
    );


    vitalCount =
        rows.length;

}


/* =========================================================
   활력징후 데이터 수집
========================================================= */

function collectVitalSigns() {

    const rows =
        document.querySelectorAll(
            "#vitalBody .vital-row"
        );


    const vitalSigns = [];


    rows.forEach(
        function(row, index) {

            function value(
                selector
            ) {

                const element =
                    row.querySelector(
                        selector
                    );


                return element
                    ? element.value
                    : "";

            }


            const vital = {

                round:
                    index + 1,

                time:
                    value(
                        ".vital-time"
                    ),

                bloodPressure:
                    value(
                        ".vital-bp"
                    ),

                pulse:
                    value(
                        ".vital-pulse"
                    ),

                respiration:
                    value(
                        ".vital-resp"
                    ),

                temperature:
                    value(
                        ".vital-temp"
                    ),

                spo2:
                    value(
                        ".vital-spo2"
                    ),

                glucose:
                    value(
                        ".vital-glucose"
                    )

            };


            const hasValue =
                Object.entries(
                    vital
                )
                .some(
                    function(
                        [key, value]
                    ) {

                        return (
                            key !== "round" &&
                            value !== ""
                        );

                    }
                );


            if (hasValue) {

                vitalSigns.push(
                    vital
                );

            }

        }
    );


    return vitalSigns;

}


/* =========================================================
   모든 데이터 수집
========================================================= */

function collectData() {

    const data = {};


    document
        .querySelectorAll(
            "input, select, textarea"
        )
        .forEach(
            function(element) {

                /*
                 * 활력징후는 별도 수집
                 */

                if (
                    element.closest(
                        "#vitalBody"
                    )
                ) {

                    return;

                }


                if (
                    element.type ===
                    "checkbox"
                ) {

                    if (
                        !data[element.name]
                    ) {

                        data[element.name] =
                            [];

                    }


                    if (
                        element.checked
                    ) {

                        data[element.name]
                            .push(
                                element.value
                            );

                    }

                }

                else {

                    data[element.id] =
                        element.value;

                }

            }
        );


    /* 활력징후 */

    data.vitalSigns =
        collectVitalSigns();


    /* GCS */

    const gcs =
        calculateGCS();


    data.GCS =
        `${gcs.total}점 (${gcs.state})`;


    data.GCS_Eye =
        document.getElementById(
            "eye"
        ).value;


    data.GCS_Verbal =
        document.getElementById(
            "verbal"
        ).value;


    data.GCS_Motor =
        document.getElementById(
            "motor"
        ).value;


    data["작성일시"] =
        new Date()
        .toLocaleString(
            "ko-KR"
        );


    return data;

}


