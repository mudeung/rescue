<script>

/* =========================================================
   Google Apps Script
========================================================= */

const GOOGLE_SCRIPT_URL =
"https://script.google.com/macros/s/AKfycbzeViWG4RE6jTu9BuLO8fi-EjtMTYvtRSjvUTZiAWMejTxfjlWs8gCtmSP6lgoTiefa2g/exec";


/* =========================================================
   전역 변수
========================================================= */

let vitalCount = 2;

let voiceInterval = null;


/* =========================================================
   현재 시간
========================================================= */

function getCurrentTime() {

    const now = new Date();

    const hours =
        String(
            now.getHours()
        ).padStart(2, "0");

    const minutes =
        String(
            now.getMinutes()
        ).padStart(2, "0");

    return `${hours}:${minutes}`;

}


/* =========================================================
   기본 날짜 / 시간
========================================================= */

function setDefaultDateTime() {

    const now =
        new Date();


    const date =
        now.toISOString()
        .slice(0, 10);


    const dateElement =
        document.getElementById(
            "date"
        );


    if (
        dateElement &&
        !dateElement.value
    ) {

        dateElement.value =
            date;

    }


    const localDateTime =
        new Date(
            now.getTime()
            -
            now.getTimezoneOffset()
            * 60000
        )
        .toISOString()
        .slice(0, 16);


    const arrivalElement =
        document.getElementById(
            "arrivalDateTime"
        );


    if (
        arrivalElement &&
        !arrivalElement.value
    ) {

        arrivalElement.value =
            localDateTime;

    }

}


/* =========================================================
   GCS 음성
========================================================= */

function speakCritical() {

    if (
        !("speechSynthesis" in window)
    ) {

        return;

    }


    speechSynthesis.cancel();


    const msg =
        new SpeechSynthesisUtterance(
            "중증 환자입니다. 즉시 기도와 호흡을 확인하십시오."
        );


    msg.lang = "ko-KR";

    msg.rate = 1;

    msg.pitch = 1;


    speechSynthesis.speak(msg);

}


/* =========================================================
   중증 알림 시작
========================================================= */

function startCriticalAlert() {

    if (voiceInterval) {

        return;

    }


    speakCritical();


    voiceInterval =
        setInterval(
            speakCritical,
            10000
        );

}


/* =========================================================
   중증 알림 중지
========================================================= */

function stopCriticalAlert() {

    if (voiceInterval) {

        clearInterval(
            voiceInterval
        );

        voiceInterval = null;

    }


    if (
        "speechSynthesis" in window
    ) {

        speechSynthesis.cancel();

    }

}


/* =========================================================
   GCS 계산
========================================================= */

function calculateGCS() {

    const eye =
        parseInt(
            document.getElementById(
                "eye"
            ).value
        );


    const verbal =
        parseInt(
            document.getElementById(
                "verbal"
            ).value
        );


    const motor =
        parseInt(
            document.getElementById(
                "motor"
            ).value
        );


    const total =
        eye + verbal + motor;


    let state;

    let color;


    if (total === 15) {

        state =
            "정상-Normal";

        color =
            "#2563eb";

    }

    else if (total >= 13) {

        state =
            "경도-Mild";

        color =
            "#16a34a";

    }

    else if (total >= 9) {

        state =
            "중등도-Moderate";

        color =
            "#f59e0b";

    }

    else if (total >= 4) {

        state =
            "중증-Severe";

        color =
            "#dc2626";

    }

    else {

        state =
            "혼수";

        color =
            "#000000";

    }


    const result =
        document.getElementById(
            "gcsResult"
        );


    result.textContent =
        `${total}점 (${state})`;


    result.style.color =
        color;


    const warning =
        document.getElementById(
            "gcsWarning"
        );


    if (total <= 8) {

        warning.style.display =
            "block";


        document.body.classList.add(
            "critical-mode"
        );


        if (navigator.vibrate) {

            navigator.vibrate([
                500,
                300,
                500
            ]);

        }


        startCriticalAlert();

    }

    else {

        warning.style.display =
            "none";


        document.body.classList.remove(
            "critical-mode"
        );


        stopCriticalAlert();

    }


    return {
        total: total,
        state: state
    };

}


/* =========================================================
   GCS 이벤트
========================================================= */

["eye", "verbal", "motor"].forEach(
    function(id) {

        document
            .getElementById(id)
            .addEventListener(
                "change",
                calculateGCS
            );

    }
);


