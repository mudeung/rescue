/*************************************************
 * 값 설정
 *************************************************/

function setValue(id, value) {

    const element =
        document.getElementById(id);

    if (
        element &&
        value !== undefined &&
        value !== null
    ) {

        element.value = value;

    }

}


/*************************************************
 * 초기화
 *************************************************/

function resetForm() {

    if (
        !confirm(
            "작성한 내용을 모두 삭제하시겠습니까?"
        )
    ) {

        return;

    }


    document
        .querySelectorAll(
            "input, select, textarea"
        )
        .forEach(
            function(element) {

                if (
                    element.type ===
                    "checkbox"
                ) {

                    element.checked =
                        false;

                } else {

                    element.value =
                        "";

                }

            }
        );


    document.getElementById(
        "vitalBody"
    ).innerHTML = "";


    addVitalRow();


    localStorage.removeItem(
        "ambulanceReport"
    );


    setToday();

    updateKTASDescription();


    showStatus(
        "초기화되었습니다.",
        "success"
    );

}


/*************************************************
 * 상태 메시지
 *************************************************/

function showStatus(
    message,
    type
) {

    const status =
        document.getElementById(
            "status"
        );


    status.textContent =
        message;


    status.className =
        "status " + type;

}


/*************************************************
 * HTML 특수문자 처리
 *************************************************/

function escapeHtml(value) {

    if (
        value === undefined ||
        value === null
    ) {

        return "";

    }


    return String(value)

        .replace(
            /&/g,
            "&amp;"
        )

        .replace(
            /</g,
            "&lt;"
        )

        .replace(
            />/g,
            "&gt;"
        )

        .replace(
            /"/g,
            "&quot;"
        )

        .replace(
            /'/g,
            "&#039;"
        );

}

