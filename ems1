function loadData() {

    const saved =
        localStorage.getItem(
            "ambulanceReport"
        );


    if (!saved) {

        return;

    }


    try {

        const data =
            JSON.parse(
                saved
            );


        /*
         * 일반 입력값 복원
         */

        document
            .querySelectorAll(
                "input, select, textarea"
            )
            .forEach(
                function(element) {

                    /*
                     * 활력징후는 별도 처리
                     */

                    if (
                        element.closest(
                            "#vitalBody"
                        )
                    ) {

                        return;

                    }


                    if (
                        element.type ===
                        "checkbox"
                    ) {

                        if (
                            data[element.name]
                        ) {

                            element.checked =
                                data[element.name]
                                .includes(
                                    element.value
                                );

                        }

                    }

                    else if (
                        data[element.id]
                        !== undefined
                    ) {

                        element.value =
                            data[element.id];

                    }

                }
            );


        /*
         * 기존 활력징후 행 제거
         */

        const tbody =
            document.getElementById(
                "vitalBody"
            );


        tbody.innerHTML =
            "";


        /*
         * 저장된 활력징후 복원
         */

        const savedVitals =
            data.vitalSigns || [];


        if (
            savedVitals.length === 0
        ) {

            createVitalRowFromData(
                1,
                {}
            );


            createVitalRowFromData(
                2,
                {}
            );

        }

        else {

            savedVitals.forEach(
                function(
                    vital,
                    index
                ) {

                    createVitalRowFromData(
                        index + 1,
                        vital
                    );

                }
            );


            /*
             * 최소 2개 행 유지
             */

            while (
                document.querySelectorAll(
                    "#vitalBody .vital-row"
                ).length < 2
            ) {

                const next =
                    document.querySelectorAll(
                        "#vitalBody .vital-row"
                    ).length + 1;


                createVitalRowFromData(
                    next,
                    {}
                );

            }

        }


        vitalCount =
            document.querySelectorAll(
                "#vitalBody .vital-row"
            ).length;


        /*
         * GCS
         */

        calculateGCS();


        /*
         * 작성기록
         */

        const text =
            createText(
                data
            );


        document
            .getElementById(
                "savedData"
            )
            .innerHTML =

            `<div class="board-item">
                ${escapeHTML(text)}
            </div>`;

    }

    catch(error) {

        console.error(
            "저장 데이터 복원 실패:",
            error
        );

    }

}


/* =========================================================
   저장된 활력징후 행 생성
========================================================= */

function createVitalRowFromData(
    number,
    vital
) {

    const tbody =
        document.getElementById(
            "vitalBody"
        );


    const row =
        document.createElement(
            "tr"
        );


    row.className =
        "vital-row";


    row.dataset.index =
        number;


    const canDelete =
        number > 2;


    row.innerHTML = `

        <td>
            <strong>
                ${number}차
            </strong>
        </td>


        <td>

            <input
                type="time"
                class="vital-time"
                value="${vital.time || ""}"
            >

        </td>


        <td>

            <input
                type="text"
                class="vital-bp"
                placeholder="120/80"
                value="${vital.bloodPressure || ""}"
            >

        </td>


        <td>

            <input
                type="number"
                class="vital-pulse"
                placeholder="80"
                value="${vital.pulse || ""}"
            >

        </td>


        <td>

            <input
                type="number"
                class="vital-resp"
                placeholder="18"
                value="${vital.respiration || ""}"
            >

        </td>


        <td>

            <input
                type="number"
                class="vital-temp"
                step="0.1"
                placeholder="36.5"
                value="${vital.temperature || ""}"
            >

        </td>


        <td>

            <input
                type="number"
                class="vital-spo2"
                placeholder="98"
                value="${vital.spo2 || ""}"
            >

        </td>


        <td>

            <input
                type="number"
                class="vital-glucose"
                placeholder="100"
                value="${vital.glucose || ""}"
            >

        </td>


        <td>

            <button
                type="button"
                class="delete-vital"
                ${canDelete ? "" : "disabled"}
                onclick="deleteVitalRow(this)"
            >
                삭제
            </button>

        </td>

    `;


    tbody.appendChild(
        row
    );

}


/* =========================================================
   초기화
========================================================= */

function resetForm() {

    if (
        !confirm(
            "작성한 내용을 모두 삭제하시겠습니까?"
        )
    ) {

        return;

    }


    /*
     * 일반 입력값 초기화
     */

    document
        .querySelectorAll(
            "input, select, textarea"
        )
        .forEach(
            function(element) {

                if (
                    element.closest(
                        "#vitalBody"
                    )
                ) {

                    return;

                }


                if (
                    element.type ===
                    "checkbox"
                ) {

                    element.checked =
                        false;

                }

                else {

                    element.value =
                        "";

                }

            }
        );


    /*
     * 활력징후 초기화
     */

    const tbody =
        document.getElementById(
            "vitalBody"
        );


    tbody.innerHTML =
        "";


    createVitalRowFromData(
        1,
        {}
    );


    createVitalRowFromData(
        2,
        {}
    );


    vitalCount = 2;


    /*
     * LocalStorage 삭제
     */

    localStorage.removeItem(
        "ambulanceReport"
    );


    /*
     * 기록 화면 초기화
     */

    document
        .getElementById(
            "savedData"
        )
        .innerHTML =
        "아직 작성된 기록이 없습니다.";


    /*
     * 중증 알림 초기화
     */

    document.body.classList.remove(
        "critical-mode"
    );


    stopCriticalAlert();


    /*
     * 날짜/시간 복구
     */

    setDefaultDateTime();


    calculateGCS();

}


/* =========================================================
   페이지 시작
========================================================= */

window.addEventListener(
    "load",
    function() {

        setDefaultDateTime();

        loadData();

        calculateGCS();

    }
);


/* =========================================================
   페이지 종료
========================================================= */

window.addEventListener(
    "beforeunload",
    function() {

        stopCriticalAlert();

    }
);

</script>

