/*************************************************
 * Google Sheets 저장
 *************************************************/

async function saveToGoogleSheets() {

    const data =
        collectData();


    showStatus(
        "Google Sheets에 저장 중입니다...",
        "success"
    );


    try {

        const response =
            await fetch(
                GOOGLE_SCRIPT_URL,
                {

                    method: "POST",

                    body:
                        JSON.stringify(data)

                }
            );


        const result =
            await response.json();


        if (!result.success) {

            throw new Error(
                result.message ||
                "저장 실패"
            );

        }


        showStatus(

            "✅ Google Sheets 저장 완료\n" +

            "기록ID: " +
            result.recordId +

            "\n활력징후: " +
            result.vitalCount +
            "건",

            "success"

        );


        /*
         * 기록ID를 로컬에도 보관
         */

        data.recordId =
            result.recordId;

        localStorage.setItem(
            "ambulanceReport",
            JSON.stringify(data)
        );


    } catch (error) {

        console.error(error);

        showStatus(

            "❌ Google Sheets 저장 실패\n" +
            error.message,

            "error"

        );

    }

}


