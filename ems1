    /*
     * 브라우저 저장
     */

    localStorage.setItem(
        "ambulanceReport",
        JSON.stringify(
            data
        )
    );


    /*
     * 작성기록 표시
     */

    document
        .getElementById(
            "savedData"
        )
        .innerHTML =

        `<div class="board-item">
            ${escapeHTML(text)}
        </div>`;


    /*
     * TXT 저장
     */

    downloadTXT(
        text
    );


    /*
     * Google Sheets
     */

    const sheetSaved =
        await sendToGoogleSheets(
            data
        );


    if (sheetSaved) {

        alert(
            "구급일지가 저장되었습니다.\n\n" +
            "브라우저 저장 + TXT 저장 + Google Sheets 저장 완료"
        );

    }

    else {

        alert(
            "구급일지는 브라우저와 TXT로 저장되었습니다.\n\n" +
            "Google Sheets 저장에는 실패했습니다."
        );

    }

}


/* =========================================================
   공유
========================================================= */

async function shareRecord() {

    const data =
        collectData();


    const text =
        createText(
            data
        );


    if (
        navigator.share
    ) {

        try {

            await navigator.share({

                title:
                    "웹 구급일지",

                text:
                    text

            });

        }

        catch(error) {

            console.log(
                "공유 취소:",
                error
            );

        }

    }

    else {

        try {

            await navigator
                .clipboard
                .writeText(
                    text
                );


            alert(
                "공유 기능을 지원하지 않아\n" +
                "기록 내용을 클립보드에 복사했습니다."
            );

        }

        catch(error) {

            alert(
                "이 브라우저에서는 공유 기능을 사용할 수 없습니다."
            );

        }

    }

}


