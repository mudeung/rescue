<button onclick="copyCustomLink()">무등산 산악사고 구조요청 링크 복사</button>

<script>
function copyCustomLink() {
  const url = "https://mudeung.github.io/rescue/gps.html";

  navigator.clipboard.writeText(url)
    .then(() => {
      alert("GPS 링크가 복사되었습니다!");
    })
    .catch(err => {
      console.error(err);
    });
}
</script>
